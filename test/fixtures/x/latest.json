e_count":3,"quoted_status_id_str":"2107459165207593046","quoted_status_permalink":{"display":"x.com/AmosMeiri/stat…","expanded":"https://twitter.com/AmosMeiri/status/2107459165207593046","url":"https://t.co/79jdXZc6MO"},"reply_count":52,"retweet_count":10,"retweeted":false,"user_id_str":"726486461638397954"},"note_tweet":{"is_expandable":true,"note_tweet_results":{"rest_id":"2109908466307403776","result":{"__typename":"NoteTweet","entity_set":{"hashtags":[],"symbols":[],"urls":[{"display_url":"antseed.com","expanded_url":"http://antseed.com","indices":[833,856],"url":"https://t.co/e7fZMWL3rx"}],"user_mentions":[{"id_str":"2024100419539255296","indices":[208,216],"name":"Antseed","screen_name":"AntSeed"},{"id_str":"36208197","indices":[236,247],"name":"BitTorrent","screen_name":"BitTorrent"},{"id_str":"2024100419539255296","indices":[293,301],"name":"Antseed","screen_name":"AntSeed"},{"id_str":"2024100419539255296","indices":[966,974],"name":"Antseed","screen_name":"AntSeed"}]},"rest_id":"2109908466307403776","text":"🚨 WHAT IF YOU COULD ACCESS 700+ AI MODELS WITHOUT BREAKING THE BANK ?\n\nMost developers are still paying expensive API fees to access AI models. But what if there were a more open, flexible alternative?\n\nMeet @AntSeed . 👇\n\nThink of what @BitTorrent did for file sharing, but for AI inference.\n\n@AntSeed is building an open marketplace where anyone can buy and sell access to AI models on their own terms.\n\nHere's what makes it interesting. 👀\n\n>▪︎ Access to 700+ models\n>▪︎ A network of 200+ providers\n>▪︎ Compatibility with Codex, Claude Code, Hermes, and more\n>▪︎ Alternative ways to access AI inference\n>▪︎ Privacy-focused access with an emphasis on anonymity\n\nYou can even experiment with combining DeepSeek models and GLM subagents to build more cost-efficient AI workflows.\n\nGetting started is simple:\n\n>▪︎ Download Antseed from https://t.co/e7fZMWL3rx.\n>▪︎ Connect your preferred coding agent.\n>▪︎ Select a provider and start exploring.\n\nBut there's more.\n\nThe @AntSeed Foundation has raised $2.4M in a token round led by Spark Capital to help bring its vision to life.\n\nThe mission ? Make AI inference more open, accessible, and flexible for everyone.\n\nAs demand for AI grows, access to affordable inference infrastructure could become a major advantage for developers and builders.\n\nAntseed is working toward that future."}}},"quoted_tweet_results":{"rest_id":"2107459165207593046","result":{"__typename":"Tweet","core":{"user_results":{"rest_id":"1361432287","result":{"__typename":"User","action_counts":{"favorites_count":16508},"avatar":{"image_url":"https://pbs.twimg.com/profile_images/2103929848230002688/x_sBCiiq_normal.jpg"},"banner":{"image_url":"https://pbs.twimg.com/profile_banners/1361432287/1790450539"},"core":{"created_at":"Thu Apr 18 08:58:36 +0000 2013","name":"Amos Meiri","screen_name":"AmosMeiri"},"dm_permissions":{"can_dm":true},"exclusive_tweet_following":false,"follow_request_sent":false,"identity_profile_labels_highlighted_label":{"label":{"badge":{"url":"https://pbs.twimg.com/profile_images/2065794411846307840/5LHnKzgo_bigger.jpg"},"description":"Antseed","url":{"url":"https://twitter.com/AntSeed","url_type":"DeepLink"},"user_label_display_type":"Badge","user_label_type":"BusinessLabel"}},"location":{"location":""},"media_permissions":{"can_media_tag":true},"notifications_settings":{"notifications_enabled":false},"pinned_items":{"tweet_ids_str":["2107459165207593046"]},"privacy":{"protected":false,"suspended":false},"private_super_following":false,"profile_bio":{"description":"Co founder @AntSeed @node_Cap,@nodemonste. co founded #ColoredCoins in 2012. Its all thanks to Satoshi. my own views, not an investment advise. 🌊🥊","entities":{"description":{"hashtags":[{"indices":[54,67],"text":"ColoredCoins"}],"user_mentions":[{"id_str":"","indices":[11,19],"name":"","screen_name":"AntSeed"},{"id_str":"","indices":[20,29],"name":"","screen_name":"node_Cap"},{"id_str":"","indices":[30,41